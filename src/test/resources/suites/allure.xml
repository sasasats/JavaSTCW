<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Allure test suite">

    <test verbose="2" preserve-order="true" name="Test incorrect authentication">
        <parameter name="Username" value="username"/>
        <parameter name="Password" value="password"/>

        <classes>
            <class name="allure.AllureTests">
                <methods>
                    <include name="testWrongAuthentication"/>
                    <include name="testDemoAuthenticationFailure"/>
                </methods>
            </class>
        </classes>
    </test>

    <test verbose="2" preserve-order="true" name="Test correct authentication">
        <classes>
            <class name="allure.AllureTests">
                <methods>
                    <include name="testCorrectAuthentication"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>